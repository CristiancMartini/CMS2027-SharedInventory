<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SharedInventory.Updater</AssemblyName>
    <RootNamespace>SharedInventory.Updater</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\Car Mechanic Simulator 2027 Demo</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Preloader.Core.dll" Private="false" />
  </ItemGroup>

</Project>
