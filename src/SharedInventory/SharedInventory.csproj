<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SharedInventory</AssemblyName>
    <!-- Must match Plugin.Version and the release tag: the updater compares it. -->
    <Version>1.1.0</Version>
    <RootNamespace>SharedInventory</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Path to the game install with BepInEx already run once (so BepInEx\interop exists). -->
    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\Car Mechanic Simulator 2027 Demo</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Fusion.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Fusion.Common.dll" Private="false" />
  </ItemGroup>

</Project>
